# Copie para .env (ou .env.local) e preencha. NUNCA faça commit do arquivo preenchido.

# Porta HTTP (plataformas de nuvem costumam definir sozinhas)
PORT=3000
# "production" serve o build de dist/; em desenvolvimento use `npm run dev`
NODE_ENV=development
# Pasta do banco SQLite e das imagens enviadas (use um volume persistente na nuvem)
DATA_DIR=./data
# URL pública HTTPS do app (usada no retorno do login Google)
APP_URL=

# Opcional: IA (sem chave, a geração de estampa fica indisponível com aviso)
GEMINI_API_KEY=
# GEMINI_TEXT_MODEL=gemini-3.5-flash
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# AI_RATE_LIMIT=20

# Opcional: login Google (OAuth). Redirect autorizado: <APP_URL>/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Opcional: desativar a conta de demonstração
# DISABLE_DEMO=true
# Para Capacitor/APK: URL HTTPS do servidor publicado
# CAP_SERVER_URL=
